{
  "version": 3,
  "configurePresets": [
    {
      "name": "mingw",
      "hidden": false,
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "mingw",
      "configuration": "Release"
    }
  ]
}
